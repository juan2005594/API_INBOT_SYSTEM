#
# Copia este archivo como ".env" (NO se sube a git) y completa los valores.
# Ruta esperada: C:\Users\pablo\OneDrive - UNIVERSIDAD DE CUNDINAMARCA\Documentos\API\.env
#
# Gmail recomendado: usa "App Password" (no tu contraseña normal).
#

DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true

# Tu correo origen
DJANGO_EMAIL_HOST_USER=TU_CORREO@gmail.com

# App Password (Google) o contraseña SMTP del proveedor
DJANGO_EMAIL_HOST_PASSWORD=TU_APP_PASSWORD

# Opcional
DJANGO_DEFAULT_FROM_EMAIL=INBOTF <TU_CORREO@gmail.com>
DJANGO_EMAIL_TIMEOUT=15

